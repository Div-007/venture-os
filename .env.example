# Venture Studio OS environment. Copy to .env; every setting is explained in docs/setup-and-operations.md.
NODE_ENV=development
APP_MODE=local
PORT=4000
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
MONGODB_URI=mongodb://127.0.0.1:27018/venture_studio_dev?replicaSet=ventureStudio
MONGODB_DB=venture_studio_dev
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ALLOW_DEV_AUTH=true
# Set FILE_STORAGE=r2 and all four R2 values to use the private development bucket.
# Missing R2 settings fail startup rather than silently storing files locally.
FILE_STORAGE=local
# RESEND_API_KEY=
# EMAIL_FROM=Venture Studio <noreply@example.com>
# Set to the first owner's real email before using /signup. Remove after claiming.
# BOOTSTRAP_ADMIN_EMAIL=owner@example.com
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=venture-studio-dev
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# Only behind a reverse proxy (nginx/Caddy) that sets X-Forwarded-For in front of the web app; see README.
# TRUST_PROXY=loopback
# Only when every request arrives through Cloudflare (production tunnel): key rate limits on the visitor's address.
# CLIENT_IP_HEADER=cf-connecting-ip
