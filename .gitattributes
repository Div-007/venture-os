# Venture Studio OS. Scripts that run inside Linux containers must keep LF line endings on Windows checkouts.
*.sh text eol=lf
deploy/mongo/*.js text eol=lf
deploy/**/Dockerfile text eol=lf
deploy/compose.yaml text eol=lf
deploy/.env.example text eol=lf
# Windows helpers.
*.cmd text eol=crlf
*.ps1 text eol=crlf
