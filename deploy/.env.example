# Venture Studio production settings (local Docker stack).
# Create your copy with:  deploy\prod.cmd init   (it fills in the secrets below that say "generated")
# After any change, apply it with:  deploy\prod.cmd up
# This file is ignored by Git and never copied into an image. Do not paste its values into chat.

# ---------------------------------------------------------------------------
# Public address (the hostname you connect to the Cloudflare Tunnel), without https://
APP_DOMAIN=app.example.com

# ---------------------------------------------------------------------------
# Generated by "prod.cmd init" - keep them secret, letters and digits only.
# The two MongoDB passwords are applied when the database is first created; changing them later needs a manual update.
BETTER_AUTH_SECRET=
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
# Generated by "prod.cmd init" (browser push keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services can use about your notifications.
VAPID_SUBJECT=mailto:admin@example.com

# ---------------------------------------------------------------------------
# Email through Resend. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Venture Studio <noreply@example.com>
# The first admin's email. Sign up at https://APP_DOMAIN/signup with it, then you may clear it.
BOOTSTRAP_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Uploaded files: the PRODUCTION R2 bucket and a token limited to it (not the development bucket).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=venture-studio-prod
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel). The tunnel starts once this is set.
TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Database backups. Every 24 hours a full backup is saved to LOCAL_BACKUP_DIR and, when the four BACKUP_R2_* values
# are set, copied to a separate R2 bucket. Use its own token so the app's token cannot touch backups.
BACKUP_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_R2_BUCKET=venture-studio-backups
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_KEEP_LOCAL_DAYS=14
BACKUP_KEEP_REMOTE_DAYS=30
# Folder on this PC for local copies (relative to the deploy folder).
LOCAL_BACKUP_DIR=../.data/prod-backups

# Claude connections (hosted MCP for Claude Code). Off unless set to true; see docs/mcp.md.
MCP_ENABLED=false
MCP_WRITES_ENABLED=true
# Company search for the Dealflow Sales connector (search_companies). Leave blank to switch it off: the tool then says search isn't set up.
TINYFISH_API_KEY=
EXA_API_KEY=
# The lead finder built into the API works queued find-leads runs (needs a key above, or one an admin saves in Sales setup). on or off.
SALES_FINDER=on

# ---------------------------------------------------------------------------
# Advanced (rarely changed)
# Port for checking the site on this PC only: http://127.0.0.1:3100
WEB_PORT=3100
MONGODB_DB=venture_studio
